# Copia para .env e preenche. O .env nunca vai para o git.

# --- Base de dados (docker compose up -d) ---
DATABASE_URL=postgres://calorie:calorie@localhost:5434/calorie_tracker
# Usada por docker-compose.yml (muda fora do desenvolvimento local)
# POSTGRES_PASSWORD=calorie

# --- API ---
PORT=3001
# Origens da web, separadas por vírgula (CORS + proteção CSRF)
WEB_ORIGIN=http://localhost:3000

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup) ---
# A DEMO_KEY tem limites muito baixos.
USDA_API_KEY=DEMO_KEY

# --- Autenticação ---
# SESSION_TTL_DAYS=30
# Põe a false depois de criares a tua conta, se a API estiver exposta na internet.
# ALLOW_REGISTRATION=true
# Por defeito só é true com NODE_ENV=production (exige HTTPS).
# COOKIE_SECURE=false
# Nº de proxies (nginx, etc.) à frente da API, para o rate limit ver o IP real.
# TRUST_PROXY=0

# --- Email (recuperação de password) — https://resend.com/api-keys ---
# Sem chave: em desenvolvimento o link aparece no terminal da API; em produção não é enviado.
# RESEND_API_KEY=re_...
# onboarding@resend.dev só entrega no email da tua conta Resend; depois usa um domínio verificado.
# MAIL_FROM=Calorie Tracker <noreply@o-teu-dominio.pt>

# --- Testes e2e (por defeito: a DATABASE_URL com "_test" no nome da BD) ---
# TEST_DATABASE_URL=postgres://calorie:calorie@localhost:5434/calorie_tracker_test
